# Copy to .env and fill in. Minimum to run: DEEPGRAM_API_KEY + LLM_API_KEY (+ PUBLIC_HOST for Twilio).

# Your ngrok host, without https:// (e.g. abcd-1234.ngrok-free.app)
PUBLIC_HOST=

# --- Speech-to-text + TTS (Deepgram: one key covers both; free credit on signup)
DEEPGRAM_API_KEY=
STT_MODEL=nova-2
# en-IN for Indian English, hi for Hindi. For Hinglish code-switching try STT_MODEL=nova-3 with STT_LANGUAGE=multi
STT_LANGUAGE=en-IN
ENDPOINTING_MS=300
UTTERANCE_END_MS=1000

# --- LLM: any OpenAI-compatible API
# OpenAI:  LLM_BASE_URL empty, LLM_MODEL=gpt-4o-mini
# Groq (free tier, very fast): LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
# Per-request timeout. A hung LLM means dead air, so keep it short.
LLM_TIMEOUT_S=15
# Older messages are dropped from the prompt beyond this (cost + latency on long calls)
MAX_HISTORY_MESSAGES=40

# --- TTS: deepgram (English) or elevenlabs (multilingual incl. Hindi)
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Turn-taking
# energy (no deps) or silero (pip install silero-vad)
VAD_PROVIDER=energy
VAD_ENERGY_THRESHOLD_DBFS=-35
BARGE_IN_MIN_SPEECH_MS=250
BARGE_IN_MIN_WORDS=2

# --- RAG: hybrid BM25 + embeddings (needs an OpenAI key; Groq has no embeddings endpoint)
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small

# --- Compliance: redact Aadhaar/PAN/card/phone/email before text reaches the LLM
REDACT_BEFORE_LLM=true

# --- Twilio (only for POST /call, where the bot calls your phone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Any random string; protects /call and the browser test phone (http://localhost:8000/)
DEMO_API_TOKEN=
# Optional: number to <Dial> when the agent transfers to a human (E.164, e.g. +919876543210).
# Empty = the agent says no human is available.
HUMAN_AGENT_NUMBER=
# Optional: secret Twilio echoes back when it opens /media-stream. Random per run if empty;
# set it if you run several instances or use scripts/simulate_call.py.
MEDIA_STREAM_TOKEN=

# Optional: what the bot says when the call connects
# GREETING=Hi, thanks for calling Kiran Electronics support. How can I help you today?
# Optional (scripts/make_test_audio.py only): a different voice for the caller test audio
# CALLER_TTS_MODEL=aura-2-orion-en

LOG_DIR=logs

%% Call graph inside CallSession (app/session.py). Solid = direct call/await, dashed = spawns a task.
graph TD
    handle_event --> _on_start
    handle_event --> _on_media
    handle_event --> _on_mark
    handle_event --> close
    _on_start --> stt_start["stt.start"]
    _on_start --> _begin_turn
    _on_media --> stt_send["stt.send"]
    _on_media --> onset_feed["onset.feed"]
    _on_media --> barge_in
    _on_mark --> _finalize_turn
    on_transcript --> barge_in
    on_transcript --> _end_user_turn
    on_utterance_end --> _end_user_turn
    _end_user_turn --> redact["pii.redact"]
    _end_user_turn --> barge_in
    _end_user_turn --> _begin_turn
    _begin_turn -.-> _respond
    _respond -.-> _produce
    _respond -.-> _consume
    _respond --> _play_sentence
    _respond --> _finalize_turn
    _produce --> stream_reply["agent.stream_reply"]
    _produce --> chunker["SentenceChunker.feed/flush"]
    _consume --> _play_sentence
    _consume --> _send_mark
    _play_sentence --> synth["tts.synthesize"]
    _play_sentence --> _send_audio
    _play_sentence --> _send_mark
    barge_in --> _finalize_turn
    _finalize_turn --> latency_write["latency_logger.write"]
    close --> _finalize_turn
    close --> stt_close["stt.close"]
    close --> _save_transcript
